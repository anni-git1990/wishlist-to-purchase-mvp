{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WishlistedItemReturnedEvent",
  "type": "object",
  "properties": {
    "eventId": { "type": "string" },
    "eventName": { "type": "string", "const": "wishlisted_item_returned" },
    "timestamp": { "type": "string" },
    "userId": { "type": "string" },
    "orderId": { "type": "string" },
    "productId": { "type": "string" },
    "returnReason": { "type": "string", "enum": ["FIT_TOO_SMALL", "FIT_TOO_LARGE", "POOR_QUALITY", "COLOR_MISMATCH", "NOT_AS_DESCRIBED", "OTHER"] },
    "experimentGroup": { "type": "string" }
  },
  "required": ["eventId", "eventName", "timestamp", "userId", "orderId", "productId", "returnReason", "experimentGroup"]
}
